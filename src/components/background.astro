---
// Fondo compartido: cuadrícula + tráfico de datos + brillo azul
---
<div class="bg-grid"></div>
<canvas id="data-traffic" class="bg-traffic"></canvas>
<div class="glow"></div>

<script>
  const canvas = document.getElementById("data-traffic") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;
  const GRID = 56;          // igual a background-size de .bg-grid
  const MAX = 12;           // paquetes simultáneos (menos = más sutil)
  const TAIL = 40;          // largo de la estela en px
  const COLOR = "124,194,255";

  type Packet = { x: number; y: number; vx: number; vy: number };
  let w = 0, h = 0, packets: Packet[] = [];

  function resize() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    w = innerWidth; h = innerHeight;
    canvas.width = w * dpr; canvas.height = h * dpr;
    canvas.style.width = w + "px"; canvas.style.height = h + "px";
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function spawn(): Packet {
    const dir = Math.random() < 0.5 ? 1 : -1;
    const speed = 0.4 + Math.random() * 0.7;
    if (Math.random() < 0.5) {
      const y = Math.floor(Math.random() * (h / GRID)) * GRID;
      return { x: dir > 0 ? -TAIL : w + TAIL, y, vx: speed * dir, vy: 0 };
    }
    const x = Math.floor(Math.random() * (w / GRID)) * GRID;
    return { x, y: dir > 0 ? -TAIL : h + TAIL, vx: 0, vy: speed * dir };
  }

  function frame() {
    ctx.clearRect(0, 0, w, h);
    if (packets.length < MAX && Math.random() < 0.03) packets.push(spawn());

    packets = packets.filter(p =>
      p.x > -TAIL * 2 && p.x < w + TAIL * 2 && p.y > -TAIL * 2 && p.y < h + TAIL * 2);

    for (const p of packets) {
      p.x += p.vx; p.y += p.vy;
      const tx = p.x - Math.sign(p.vx) * TAIL;
      const ty = p.y - Math.sign(p.vy) * TAIL;

      const g = ctx.createLinearGradient(tx, ty, p.x, p.y);
      g.addColorStop(0, `rgba(${COLOR},0)`);
      g.addColorStop(1, `rgba(${COLOR},.35)`);
      ctx.strokeStyle = g; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(tx + .5, ty + .5); ctx.lineTo(p.x + .5, p.y + .5); ctx.stroke();

      ctx.fillStyle = `rgba(${COLOR},.85)`;
      ctx.beginPath(); ctx.arc(p.x + .5, p.y + .5, 1.5, 0, Math.PI * 2); ctx.fill();
    }
    requestAnimationFrame(frame);
  }

  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    resize();
    addEventListener("resize", resize);
    requestAnimationFrame(frame);
  }
</script>
