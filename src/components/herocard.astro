---
const nombre = "MILTON ALVARADO";
const resumen = `SOC Analyst focused on security monitoring, threat detection, incident analysis 
                and response. I work with SIEM, networking, Windows/Linux environments and security 
                tools to identify and investigate suspicious activity. I also have development 
                knowledge that complements my technical background.`;
const foto = "/YoBCH.jpg"; 
---
<section class="hero">
  <div class="hero__content">
    <h1>{nombre}</h1>
    <p>{resumen}</p>
    <div class="dots">
      <span class="dot dot--red"></span>
      <span class="dot dot--yellow"></span>
      <span class="dot dot--green"></span>
    </div>
  </div>
  <div class="hero__avatar">
    <img src={foto} alt="Profile photo" />
  </div>
</section>
