---
const nombre = "MILTON ALVARADO";
const resumen = `Developer focused on clean design, logical architecture and technical efficiency.
I want every project to convey clarity, security and professionalism from the very first interaction.`;
const foto = "/YoBCH.jpg"; 
---
<section class="hero">
  <div class="hero__content">
    <h1>{nombre}</h1>
    <p>{resumen}</p>
    <div class="dots">
      <span class="dot dot--red"></span>
      <span class="dot dot--yellow"></span>
      <span class="dot dot--green"></span>
    </div>
  </div>
  <div class="hero__avatar">
    <img src={foto} alt="Profile photo" />
  </div>
</section>
