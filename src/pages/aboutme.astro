---
import Layout from "../layouts/layout.astro";
import Sidebar from "../components/sidebar.astro";
import HeroCard from "../components/herocard.astro";
import { skills, languages, levelScore, levelRank,
        vision, education, hobbies, emprendimiento }
        from "../content/db/data.ts";

const pageTitle = "About Me";

/** Intro */
const intro = [
  'My name is Milton Alvarado. I am a SOC Analyst focused on cybersecurity monitoring, threat detection, incident analysis and security operations. My experience includes working with SIEM environments, Active Directory, Windows and Linux systems, networking, endpoint monitoring and threat intelligence.',
'I enjoy analyzing security events, identifying suspicious behavior and understanding how systems and networks interact in order to detect and respond to potential threats.',
'I also have knowledge of software development and web technologies, which complements my cybersecurity profile and helps me better understand applications, systems and potential attack surfaces.'
];

const sortByLevelDesc = (items: { name: string; level: string }[]) =>
  [...items].sort((a, b) => (levelRank[b.level] ?? 0) - (levelRank[a.level] ?? 0));

function pct(level: string) {
  return levelScore[level] ?? 0;
}

const more = [
  { title: "Professional Vision", text: vision },
  { title: "Education", text: education },
  { title: "Hobbies", text: hobbies },
  { title: "Entrepreneurship", text: emprendimiento },
];
---

<Layout page={pageTitle}>
  <div class="app">
    <Sidebar />

    <main class="content">
      <HeroCard />

      <div class="mx-auto max-w-6xl mt-8 space-y-6">
        <!-- Intro -->
        <section class="glass-panel space-y-4 leading-relaxed text-zinc-200">
          <h2 class="text-2xl font-semibold">About me</h2>
          {intro.map((p) => <p>{p}</p>)}
        </section>

        <!-- Skills -->
        <section class="glass-panel">
          <h2 class="text-2xl font-semibold">Skills and expertise level</h2>
          <p class="mt-2 text-sm text-zinc-400">
            Enthusiast 5–25%, Intermediate 26–50%, Proficient 51–64%, Advanced 65–79%, Expert 80–100%.
          </p>

          <div class="mt-8 space-y-10">
            {skills.map((group) => {
              const ordered = sortByLevelDesc(group.items);
              const mid = Math.ceil(ordered.length / 2);
              const cols = [ordered.slice(0, mid), ordered.slice(mid)];

              return (
                <div class="border-t border-white/10 pt-8 first:pt-0 first:border-0">
                  <h3 class="text-xl font-semibold mb-6">{group.title}</h3>
                  <div class="grid grid-cols-1 md:grid-cols-2 md:gap-x-16 gap-y-4">
                    {cols.map((col) => (
                      <div class="space-y-4">
                        {col.map((s) => (
                          <div class="space-y-1.5">
                            <div class="flex items-center justify-between text-sm">
                              <span>{s.name}</span>
                              <span class="text-zinc-400">{s.level}</span>
                            </div>
                            <div class="bar-track">
                              <div class="bar-fill" style={`width:${pct(s.level)}%`} title={`${s.name} • ${s.level}`} />
                            </div>
                          </div>
                        ))}
                      </div>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        </section>

        <!-- Languages -->
        <section class="glass-panel">
          <h2 class="text-2xl font-semibold">Languages</h2>
          <div class="mt-6 space-y-4 max-w-xl">
            {languages.map((l) => (
              <div class="space-y-1.5">
                <div class="flex items-center justify-between text-sm">
                  <span class="font-medium">{l.name}</span>
                  <span class="text-zinc-400">{l.level}</span>
                </div>
                <div class="bar-track">
                  <div class="bar-fill" style={`width:${pct(l.level)}%`} title={`${l.name} • ${l.level}`} />
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Vision, Education, Hobbies, Entrepreneurship -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pb-8">
          {more.map((m) => (
            <section class="glass-panel space-y-4">
              <h2 class="text-2xl font-semibold">{m.title}</h2>
              <p class="leading-relaxed text-zinc-300">{m.text}</p>
            </section>
          ))}
        </div>
      </div>
    </main>
  </div>
</Layout>
