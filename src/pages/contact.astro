---
import Layout from "../layouts/layout.astro";
import Sidebar from "../components/sidebar.astro";
import HeroCard from "../components/herocard.astro";

const pageTitle = "Contact";
---
<Layout page={pageTitle}>
  <div class="app">
    <Sidebar />

    <main class="content">
      <HeroCard />

      <section class="glass-panel mx-auto max-w-4xl mt-12">
        <h1 class="text-2xl md:text-3xl font-bold text-center mb-2">CONTACT</h1>
        <div class="w-24 h-[2px] mb-6 mx-auto bg-gradient-to-r from-transparent via-[#7cc2ff]/60 to-transparent"></div>
        <p class="text-zinc-300 mb-10 text-center">You can find me at</p>

        <div class="flex flex-wrap justify-center gap-6">
          <!-- Email -->
          <div class="contact-card">
            <div class="flex flex-col items-center gap-3">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
              <p class="text-sm font-semibold text-white">4lej4ndrobusiness@gmail.com</p>
            </div>
            <a href="mailto:4lej4ndrobusiness@gmail.com"
               class="absolute inset-0 rounded-2xl focus:outline-none focus:ring-2 focus:ring-[#7cc2ff]/60"
               aria-label="Send an email to 4lej4ndrobusiness@gmail.com"></a>
          </div>

          <!-- Phone -->
          <div class="contact-card">
            <div class="flex flex-col items-center gap-3">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
              <p class="text-sm font-semibold text-white">+504 9574-9162</p>
            </div>
          </div>

          <!-- LinkedIn -->
          <div class="contact-card">
            <div class="flex flex-col items-center gap-3">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"/></svg>
              <p class="text-sm font-semibold text-white">Milton Alvarado</p>
            </div>
            <a href="https://www.linkedin.com/in/milton-alvarado-0a024b343"
               target="_blank" rel="noopener"
               class="absolute inset-0 rounded-2xl focus:outline-none focus:ring-2 focus:ring-[#7cc2ff]/60"
               aria-label="Go to LinkedIn"></a>
          </div>
        </div>
      </section>
    </main>
  </div>
</Layout>
