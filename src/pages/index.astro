---
import Layout from "../layouts/layout.astro";
import Background from "../components/background.astro";

const pageTitle = "Home";
const links = [
  { href: "/", label: "HOME" },
  { href: "/projects", label: "PROJECTS" },
  { href: "/aboutme", label: "ABOUT ME" },
  { href: "/contact", label: "CONTACT" },
];
const current = Astro.url.pathname;
---
<Layout page={pageTitle}>
  <Background />

  <main class="min-h-[100svh] flex flex-col">
    <nav class="site-nav sticky top-0 z-50">
      <div class="mx-auto max-w-6xl px-6 h-16 flex items-center justify-between">
        <a href="/" class="font-extrabold tracking-tight text-lg">MA<span class="text-[#7cc2ff]">.</span></a>
        <ul class="flex gap-1">
          {links.map((l) => (
            <li>
              <a href={l.href}
                 class={`px-3 py-2 rounded-lg text-xs sm:text-sm font-medium tracking-wide transition-colors
                 ${current === l.href ? "text-white bg-white/10" : "text-zinc-400 hover:text-white hover:bg-white/5"}`}>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <section class="flex-1 mx-auto w-full max-w-6xl px-6 py-16 grid gap-14 md:grid-cols-[1.2fr_1fr] items-center">
      <div>
        <span class="reveal inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-zinc-300" style="--d:0ms">
          <span class="badge-dot"></span> Available for new projects
        </span>

        <h1 class="reveal mt-6 text-4xl sm:text-6xl font-extrabold tracking-tight leading-[1.05]" style="--d:100ms">
          Milton Alvarado<br />
          <span class="text-gradient">Cybersecurity SOC Analyst</span>
        </h1>

        <p class="reveal mt-6 max-w-[55ch] text-zinc-400 leading-relaxed" style="--d:200ms">
          Threats rarely announce themselves. They hide in logs, traffic, patterns and small 
          anomalies that are easy to overlook. Through my experience, skills and projects,
          this portfolio reveals how I transform cyber intelligence into focused investigation, 
          connect critical signals and uncover meaningful patterns within the noise.
          What looks like noise may tell a much bigger story.
        </p>

        <div class="reveal mt-8 flex flex-wrap gap-3" style="--d:300ms">
          <a href="/projects" class="btn-cta">See Projects <span>→</span></a>
          <a href="/contact" class="btn-ghost">Contact</a>
        </div>
      </div>

      <div class="reveal-photo justify-self-center" style="--d:350ms">
        <div class="avatar-frame">
          <img src="/YoBCH.jpg" alt="Photo of Milton Alvarado"
               class="block w-72 h-72 sm:w-96 sm:h-96 object-cover rounded-[26px] bg-zinc-900" />
        </div>
      </div>
    </section>
  </main>
</Layout>
